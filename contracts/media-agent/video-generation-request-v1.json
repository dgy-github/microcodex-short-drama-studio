{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/video-generation-request-v1.json",
  "title": "Video generation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "project_id", "image_artifact_ref", "story_spans", "prompt"],
  "properties": {
    "schema": {"const": "video-generation-request/v1"},
    "request_id": {"type": "string", "pattern": "^vid_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "minLength": 1},
    "image_artifact_ref": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
    "story_spans": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prompt": {"type": "string", "minLength": 1},
    "generation_tier": {"enum": ["coarse", "fine"]}
  }
}
