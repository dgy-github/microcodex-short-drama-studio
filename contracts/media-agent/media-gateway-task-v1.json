{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/media-gateway-task-v1.json",
  "title": "Media gateway asynchronous task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "status_url"],
  "properties": {
    "schema": {"const": "media-gateway-task/v1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "status_url": {"type": "string", "format": "uri"}
  }
}
