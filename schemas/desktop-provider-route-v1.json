{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/desktop-provider-route-v1.json",
  "title": "Desktop provider route v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "profile",
    "endpoint",
    "model",
    "thinking_disabled",
    "source",
    "record_id",
    "updated_at_unix_ms"
  ],
  "properties": {
    "schema": {"const": "desktop-provider-route/v1"},
    "provider": {"enum": ["deepseek", "aliyun_bailian"]},
    "profile": {"const": "default"},
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://.+/chat/completions$"
    },
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "thinking_disabled": {"type": "boolean"},
    "source": {"enum": ["default", "user"]},
    "record_id": {
      "type": ["string", "null"],
      "pattern": "^route_[a-f0-9]{32}$"
    },
    "updated_at_unix_ms": {"type": ["integer", "null"], "minimum": 0}
  }
}
