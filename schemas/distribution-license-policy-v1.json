{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/distribution-license-policy-v1.json",
  "title": "Distribution License Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dependencies"],
  "properties": {
    "schema": { "const": "distribution-license-policy/v1" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "name",
          "source",
          "revision",
          "license",
          "evidence_path",
          "evidence_sha256",
          "approved_for_distribution",
          "reviewed_by",
          "reviewed_at"
        ],
        "properties": {
          "ecosystem": { "enum": ["cargo", "npm", "python"] },
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "format": "uri" },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "license": { "type": "string", "minLength": 1 },
          "evidence_path": {
            "type": ["string", "null"],
            "pattern": "^third_party/licenses/"
          },
          "evidence_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "approved_for_distribution": { "type": "boolean" },
          "reviewed_by": { "type": ["string", "null"], "minLength": 1 },
          "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "approved_for_distribution": { "const": true }
              },
              "required": ["approved_for_distribution"]
            },
            "then": {
              "properties": {
                "license": { "not": { "const": "UNKNOWN" } },
                "evidence_path": { "type": "string" },
                "evidence_sha256": { "type": "string" },
                "reviewed_by": { "type": "string" },
                "reviewed_at": { "type": "string" }
              }
            },
            "else": {
              "properties": {
                "license": { "const": "UNKNOWN" },
                "evidence_path": { "type": "null" },
                "evidence_sha256": { "type": "null" },
                "reviewed_by": { "type": "null" },
                "reviewed_at": { "type": "null" }
              }
            }
          }
        ]
      }
    }
  }
}
