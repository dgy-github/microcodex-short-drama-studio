{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/provider-pricing-catalog-v1.json",
  "title": "Provider pricing catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "effective_at", "entries"],
  "properties": {
    "schema": {"const": "provider-pricing-catalog/v1"},
    "catalog_id": {"type": "string", "minLength": 1},
    "effective_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "prompt_cny_fen_per_million_tokens", "completion_cny_fen_per_million_tokens"],
        "properties": {
          "provider": {"type": "string", "pattern": "^[a-z0-9_][a-z0-9_.-]{0,63}$"},
          "model": {"type": "string", "minLength": 1, "maxLength": 128},
          "prompt_cny_fen_per_million_tokens": {"type": "integer", "minimum": 0},
          "completion_cny_fen_per_million_tokens": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
