{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/story-job-v1.json",
  "title": "Story Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "input", "genre_mode", "audience", "format", "budget"],
  "properties": {
    "schema": {"const": "story-job/v1"},
    "job_id": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "genre_mode": {"enum": ["auto", "fixed"]},
    "allowed_genres": {"type": "array", "items": {"type": "string"}},
    "audience": {"type": "string", "minLength": 1},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodes", "minutes_per_episode"],
      "properties": {
        "episodes": {"type": "integer", "minimum": 1},
        "minutes_per_episode": {"type": "integer", "minimum": 1}
      }
    },
    "content_limits": {"type": "array", "items": {"type": "string"}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_cny_fen", "deadline_seconds"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_cny_fen": {"type": "integer", "minimum": 0},
        "deadline_seconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}

