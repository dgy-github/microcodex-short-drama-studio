{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/story-package-v1.json",
  "title": "Story Package v1",
  "description": "Content schema for the final story artifact. Unlike story-artifact-v1.json, which is a reference wrapper carrying only a content hash, this defines the interior. Every addressable leaf carries a node_id so that judge reasoning, seeded defect keys, and targeted revision can cite a stable location. Contract: docs/STORY_EVAL_V1.md section 9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "job_id", "logline", "promise", "characters", "beats", "episodes", "scenes", "continuity_ledger", "production", "provenance"],

  "$defs": {
    "node_id": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9]+$",
      "description": "Unique among siblings, not globally. The path from the root gives the global address."
    },
    "span_ref": {
      "type": "string",
      "pattern": "^story-package(/[a-z]+-[0-9]+)+$",
      "description": "story-package/<kind>-<index>(/<kind>-<index>)*, e.g. story-package/scene-2/dialogue-7"
    },
    "text": {"type": "string", "minLength": 1}
  },

  "properties": {
    "schema": {"const": "story-package/v1"},
    "package_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "case_id": {
      "type": ["string", "null"],
      "description": "Set when produced for evaluation; null for production jobs."
    },

    "supersedes": {"type": ["string", "null"]},
    "node_correspondence": {
      "type": ["array", "null"],
      "description": "Required whenever supersedes is set. Without it, defect keys cannot survive a revision and localisation metrics break across rounds.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["previous", "current"],
        "properties": {
          "previous": {"$ref": "#/$defs/span_ref"},
          "current": {
            "oneOf": [{"$ref": "#/$defs/span_ref"}, {"const": "removed"}]
          },
          "changed": {"type": "boolean"}
        }
      }
    },

    "logline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "text"],
      "properties": {
        "node_id": {"$ref": "#/$defs/node_id"},
        "text": {"$ref": "#/$defs/text"}
      }
    },

    "promise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "genre", "audience", "tone"],
      "properties": {
        "node_id": {"$ref": "#/$defs/node_id"},
        "genre": {"type": "string"},
        "audience": {"type": "string"},
        "tone": {"type": "string"}
      }
    },

    "characters": {
      "type": "array",
      "minItems": 1,
      "description": "Five required fields per card, per the parent contract. A card missing contradiction or secret is the usual shape of HUMAN_GENERIC.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "name", "desire", "fear", "contradiction", "secret", "change"],
        "properties": {
          "node_id": {"$ref": "#/$defs/node_id"},
          "name": {"$ref": "#/$defs/text"},
          "desire": {"$ref": "#/$defs/text"},
          "fear": {"$ref": "#/$defs/text"},
          "contradiction": {"$ref": "#/$defs/text"},
          "secret": {"$ref": "#/$defs/text"},
          "change": {"$ref": "#/$defs/text"},
          "voice_markers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },

    "beats": {
      "type": "array",
      "minItems": 1,
      "description": "Causal chain. `caused_by` makes PLOT_CONVENIENCE mechanically detectable: a beat with no antecedent that resolves existing pressure is a coincidence.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "pressure", "choice", "consequence"],
        "properties": {
          "node_id": {"$ref": "#/$defs/node_id"},
          "pressure": {"$ref": "#/$defs/text"},
          "choice": {"$ref": "#/$defs/text"},
          "consequence": {"$ref": "#/$defs/text"},
          "actor": {"$ref": "#/$defs/span_ref"},
          "caused_by": {
            "type": "array",
            "items": {"$ref": "#/$defs/span_ref"}
          }
        }
      }
    },

    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "index", "opening_state", "conflict", "turn", "end_hook"],
        "properties": {
          "node_id": {"$ref": "#/$defs/node_id"},
          "index": {"type": "integer", "minimum": 1},
          "opening_state": {"$ref": "#/$defs/text"},
          "conflict": {"$ref": "#/$defs/text"},
          "turn": {"$ref": "#/$defs/text"},
          "end_hook": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "text", "kind", "consequence_in"],
            "properties": {
              "node_id": {"$ref": "#/$defs/node_id"},
              "text": {"$ref": "#/$defs/text"},
              "kind": {
                "type": "string",
                "description": "Hook shape. Repetition of one kind across episodes is a pacing defect."
              },
              "consequence_in": {
                "oneOf": [{"$ref": "#/$defs/span_ref"}, {"const": "none"}],
                "description": "Where the hook actually pays off. `none` is the literal definition of HOOK_FAKE and makes it checkable without a judge."
              }
            }
          },
          "beats": {
            "type": "array",
            "items": {"$ref": "#/$defs/span_ref"}
          }
        }
      }
    },

    "scenes": {
      "type": "array",
      "minItems": 2,
      "description": "At least two representative scripted scenes, per the parent contract.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "episode_ref", "location", "lines"],
        "properties": {
          "node_id": {"$ref": "#/$defs/node_id"},
          "episode_ref": {"$ref": "#/$defs/span_ref"},
          "location": {"$ref": "#/$defs/text"},
          "lines": {
            "type": "array",
            "minItems": 1,
            "description": "Ordered. Action and dialogue share one sequence so that span refs match reading order.",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["node_id", "kind", "text"],
                  "properties": {
                    "node_id": {"$ref": "#/$defs/node_id"},
                    "kind": {"const": "action"},
                    "text": {"$ref": "#/$defs/text"}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["node_id", "kind", "speaker", "text"],
                  "properties": {
                    "node_id": {"$ref": "#/$defs/node_id"},
                    "kind": {"const": "dialogue"},
                    "speaker": {"$ref": "#/$defs/span_ref"},
                    "text": {"$ref": "#/$defs/text"},
                    "subtext": {
                      "type": ["string", "null"],
                      "description": "What the speaker wants but does not say. Null means the line says exactly what it means; a scene where every subtext is null is the shape of MOTIVE_EXPLICIT."
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },

    "continuity_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "relationships", "timeline", "setups"],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "statement"],
            "properties": {
              "node_id": {"$ref": "#/$defs/node_id"},
              "statement": {"$ref": "#/$defs/text"},
              "established_in": {"$ref": "#/$defs/span_ref"}
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "from", "to", "relation"],
            "properties": {
              "node_id": {"$ref": "#/$defs/node_id"},
              "from": {"$ref": "#/$defs/span_ref"},
              "to": {"$ref": "#/$defs/span_ref"},
              "relation": {"$ref": "#/$defs/text"}
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "when", "event"],
            "properties": {
              "node_id": {"$ref": "#/$defs/node_id"},
              "when": {"$ref": "#/$defs/text"},
              "event": {"$ref": "#/$defs/text"}
            }
          }
        },
        "setups": {
          "type": "array",
          "description": "Planted/payoff pairs. Reference integrity alone is not enough — a payoff that carries no accumulated pressure passes this check and still fails causally, which is why `pays_off_pressure` is recorded separately.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "planted_in", "paid_off_in"],
            "properties": {
              "node_id": {"$ref": "#/$defs/node_id"},
              "planted_in": {"$ref": "#/$defs/span_ref"},
              "paid_off_in": {
                "oneOf": [{"$ref": "#/$defs/span_ref"}, {"const": "unpaid"}]
              },
              "pays_off_pressure": {"$ref": "#/$defs/span_ref"}
            }
          }
        }
      }
    },

    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locations", "speaking_cast"],
      "description": "Declared so producibility is checkable against case constraints without reading prose.",
      "properties": {
        "locations": {"type": "array", "items": {"type": "string"}},
        "speaking_cast": {
          "type": "array",
          "items": {"$ref": "#/$defs/span_ref"}
        }
      }
    },

    "provenance": {
      "type": "array",
      "description": "Retrieved evidence IDs only. Licensed source text is never copied into the package.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "license_id", "usage"],
        "properties": {
          "source_id": {"type": "string"},
          "license_id": {"type": "string"},
          "usage": {"type": "string"}
        }
      }
    }
  },

  "dependentRequired": {
    "supersedes": ["node_correspondence"]
  }
}
