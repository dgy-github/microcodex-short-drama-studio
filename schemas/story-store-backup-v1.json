{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/story-store-backup-v1.json",
  "title": "Story Store Backup Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "store_version", "files"],
  "properties": {
    "schema": { "const": "story-store-backup/v1" },
    "store_version": { "const": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
