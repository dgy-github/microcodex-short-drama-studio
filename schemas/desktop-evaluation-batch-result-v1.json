{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/desktop-evaluation-batch-result-v1.json",
  "title": "Desktop Evaluation Batch Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "dataset_id", "mode", "evidence_status", "selected_count", "completed_count", "failed_count", "results", "occurred_at_unix_ms"],
  "properties": {
    "schema": {"const": "desktop-evaluation-batch-result/v1"},
    "batch_id": {"type": "string", "pattern": "^eval_[a-z0-9]{16,64}$"},
    "dataset_id": {"enum": ["offline-v0.1.0", "online-local"]},
    "mode": {"const": "automatic"},
    "evidence_status": {"const": "partial_advisory"},
    "selected_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "completed_count": {"type": "integer", "minimum": 0},
    "failed_count": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "status", "failed_gates", "score_record"],
        "properties": {
          "case_id": {"type": "string"},
          "status": {"enum": ["completed", "failed"]},
          "failed_gates": {"type": "array", "items": {"type": "string"}},
          "score_record": {
            "oneOf": [
              {"$ref": "eval-score-record-v1.json"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "occurred_at_unix_ms": {"type": "integer", "minimum": 1}
  }
}
