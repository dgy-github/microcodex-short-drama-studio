{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage0-judge-output/v1",
  "type": "object",
  "required": ["A", "B", "preferred"],
  "additionalProperties": false,
  "properties": {
    "A": {"$ref": "#/$defs/artifactScores"},
    "B": {"$ref": "#/$defs/artifactScores"},
    "preferred": {"enum": ["A", "B", "tie"]}
  },
  "$defs": {
    "dimensionScore": {
      "type": "object",
      "required": ["score", "reason", "spans"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "reason": {"type": "string", "minLength": 1, "maxLength": 600},
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifactScores": {
      "type": "object",
      "required": [
        "human_credibility",
        "character_distinction",
        "dialogue_subtext",
        "causal_coherence",
        "continuity",
        "emotional_progression",
        "short_drama_pacing",
        "genre_fulfillment",
        "originality",
        "producibility"
      ],
      "additionalProperties": false,
      "properties": {
        "human_credibility": {"$ref": "#/$defs/dimensionScore"},
        "character_distinction": {"$ref": "#/$defs/dimensionScore"},
        "dialogue_subtext": {"$ref": "#/$defs/dimensionScore"},
        "causal_coherence": {"$ref": "#/$defs/dimensionScore"},
        "continuity": {"$ref": "#/$defs/dimensionScore"},
        "emotional_progression": {"$ref": "#/$defs/dimensionScore"},
        "short_drama_pacing": {"$ref": "#/$defs/dimensionScore"},
        "genre_fulfillment": {"$ref": "#/$defs/dimensionScore"},
        "originality": {"$ref": "#/$defs/dimensionScore"},
        "producibility": {"$ref": "#/$defs/dimensionScore"}
      }
    }
  }
}
