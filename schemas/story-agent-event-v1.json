{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/story-agent-event-v1.json",
  "title": "Story Agent Durable Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "event_id", "seq", "occurred_at", "causation_id",
    "correlation_id", "job_id", "run_id", "event_type", "schema_version", "payload"
  ],
  "properties": {
    "protocol": {"const": "story-agent-event/v1"},
    "event_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "causation_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "job_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "event_type": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "payload": {}
  }
}

