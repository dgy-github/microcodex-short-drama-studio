{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/story-capability-request-v1.json",
  "title": "Story capability request v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "capability", "request_id", "route", "system", "prompt"],
      "properties": {
        "schema": {"const": "story-capability-request/v1"},
        "capability": {"const": "generate_structured_text"},
        "request_id": {"type": "string", "minLength": 1},
        "route": {"enum": ["generation", "review"]},
        "system": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "capability", "request_id", "artifact_schema", "artifact", "expected_episodes"],
      "properties": {
        "schema": {"const": "story-capability-request/v1"},
        "capability": {"const": "validate_artifact"},
        "request_id": {"type": "string", "minLength": 1},
        "artifact_schema": {"const": "story-package/v1"},
        "artifact": {"$ref": "story-package-v1.json"},
        "expected_episodes": {"type": "integer", "minimum": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "capability", "request_id", "run_id", "task_id", "artifact_schema", "artifact"],
      "properties": {
        "schema": {"const": "story-capability-request/v1"},
        "capability": {"const": "retain_artifact"},
        "request_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "task_id": {"pattern": "^t(0[1-9]|1[0-7])$", "type": "string"},
        "artifact_schema": {"type": "string", "minLength": 1},
        "artifact": {"type": "object"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "capability", "request_id", "content_ref", "content_sha256"],
      "properties": {
        "schema": {"const": "story-capability-request/v1"},
        "capability": {"const": "load_artifact"},
        "request_id": {"type": "string", "minLength": 1},
        "content_ref": {"type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  ]
}

