{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/credential-audit-event-v1.json",
  "title": "Credential Audit Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "occurred_at_unix_seconds", "provider", "profile", "action", "previous_hash", "event_hash"],
  "properties": {
    "schema": { "const": "credential-audit-event/v1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurred_at_unix_seconds": { "type": "integer", "minimum": 0 },
    "provider": { "enum": ["deepseek", "aliyun_bailian"] },
    "profile": { "const": "default" },
    "action": { "enum": ["configured", "rotated", "deleted"] },
    "previous_hash": { "type": "string", "minLength": 7 },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
