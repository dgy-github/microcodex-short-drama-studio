{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/human-writing-profile-v1.json",
  "title": "Human writing profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "task_directives"],
  "properties": {
    "schema": {"const": "human-writing-profile/v1"},
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-v[0-9]+$"
    },
    "task_directives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t07", "t10", "t12", "t15", "t16"],
      "properties": {
        "t07": {"$ref": "#/$defs/directives"},
        "t10": {"$ref": "#/$defs/directives"},
        "t12": {"$ref": "#/$defs/directives"},
        "t15": {"$ref": "#/$defs/directives"},
        "t16": {"$ref": "#/$defs/directives"}
      }
    }
  },
  "$defs": {
    "directives": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
