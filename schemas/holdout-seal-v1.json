{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/holdout-seal-v1.json",
  "title": "Sealed holdout commitment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "seal_id", "eval_version", "case_count", "file_count",
    "commitment_sha256", "created_at", "allowed_uses", "status"
  ],
  "properties": {
    "schema": {"const": "holdout-seal/v1"},
    "seal_id": {"type": "string", "pattern": "^seal_[a-f0-9]{32}$"},
    "eval_version": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 1},
    "file_count": {"type": "integer", "minimum": 1},
    "commitment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"const": "evaluation"}]
    },
    "status": {"const": "sealed"}
  }
}
