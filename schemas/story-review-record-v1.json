{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/story-review-record-v1.json",
  "title": "Story review record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_id", "task_id", "review_type", "status", "summary", "findings"],
  "properties": {
    "schema": {"const": "story-review-record/v1"},
    "review_id": {"type": "string", "minLength": 1},
    "task_id": {"enum": ["t11", "t12", "t13", "t14", "t16"]},
    "review_type": {
      "enum": ["continuity", "human_taste", "originality", "production", "final"]
    },
    "status": {"enum": ["pass", "revise", "reject"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defect_id", "severity", "span_ref", "evidence", "requested_change"],
        "properties": {
          "defect_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "major", "minor", "note"]},
          "span_ref": {
            "type": "string",
            "pattern": "^story-package(/[a-z]+-[0-9]+)+$"
          },
          "evidence": {"type": "string", "minLength": 1},
          "requested_change": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

