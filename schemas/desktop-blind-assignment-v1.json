{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microcodex.local/schemas/desktop-blind-assignment-v1.json",
  "title": "Desktop Blind Assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assignment_id", "alias", "prompt", "constraints", "artifact", "dimensions", "allowed_spans"],
  "properties": {
    "schema": {"const": "desktop-blind-assignment/v1"},
    "assignment_id": {"type": "string", "pattern": "^blind_[a-z0-9]{16,64}$"},
    "alias": {"type": "string", "minLength": 1},
    "prompt": {"type": "string"},
    "constraints": {"type": "object"},
    "artifact": {"$ref": "story-package-v1.json"},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "name", "ask", "anchors"],
        "properties": {
          "dimension_id": {"type": "string"},
          "name": {"type": "string"},
          "ask": {"type": "string"},
          "anchors": {
            "type": "object",
            "required": ["1", "3", "5"],
            "properties": {
              "1": {"type": "string"},
              "3": {"type": "string"},
              "5": {"type": "string"}
            }
          }
        }
      }
    },
    "allowed_spans": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^story-package(/[a-z]+-[0-9]+)+$"}
    }
  }
}
