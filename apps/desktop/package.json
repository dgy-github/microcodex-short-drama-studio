{
  "name": "microcodex-short-drama-desktop",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:tauri",
    "build:e2e:tauri": "npm run build && cargo build --features custom-protocol --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target-e2e",
    "test:e2e:tauri": "npm run build:e2e:tauri && wdio run wdio.conf.ts",
    "test:e2e:tauri:debug": "npm run build:e2e:tauri && wdio run wdio.conf.ts --logLevel debug",
    "tauri": "tauri",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "2.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-service": "^1.3.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^25.0.1",
    "svelte-check": "4.3.4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "extract-zip": "2.0.1",
    "serialize-javascript": "7.1.1"
  }
}
