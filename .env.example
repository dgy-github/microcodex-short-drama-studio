# Copy to .env and fill in. .env is gitignored; this template is tracked.
#
# Generator (DeepSeek) — used by eval/tools/generate_baselines.py
GENERATOR_API_KEY=
GENERATOR_ENDPOINT=https://api.deepseek.com/chat/completions
GENERATOR_MODEL=deepseek-v4-pro

# Judges. The manifest requires at least two judge models from different
# families, and the judge set must stay disjoint from the generator set.
JUDGE_API_KEY=            # judge 1 (Qwen)
REVIEW_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
REVIEW_MODEL=qwen3-vl-plus
JUDGE_API_KEY_GLM=        # judge 2 (GLM / Zhipu)
